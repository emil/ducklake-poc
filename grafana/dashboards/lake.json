            "uid": "ducklake-catalog"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT stage, sum(row_group_rows) AS rows FROM wave_manifest GROUP BY stage ORDER BY rows DESC"
