            "uid": "ducklake-catalog"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(extract(epoch FROM now() - min(created_at)), 0) AS age FROM ingest_queue WHERE status = 'pending'"
        }
      ],
      "fieldConfig": {
        "defaults": {
