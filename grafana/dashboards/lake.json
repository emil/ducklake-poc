  "panels": [
    {
      "id": 11,
      "type": "stat",
      "title": "Rows (samples) in waves",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ducklake-catalog"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ducklake-catalog"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(sum(record_count), 0) AS rows FROM ducklake_data_file WHERE end_snapshot IS NULL AND table_id IN (SELECT table_id FROM ducklake_table WHERE table_name = 'waves' AND end_snapshot IS NULL)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "description": "Active DuckLake data files of the waves table, from the catalog. All data_versions are included. No Parquet is read."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Waves (own row groups)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ducklake-catalog"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ducklake-catalog"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(DISTINCT (experiment, shot, stage, wave_min, data_version)) AS waves FROM wave_manifest WHERE wave_min = wave_max"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "description": "Waves with dedicated row groups. Small waves that compaction packs together are not counted here."
    },
