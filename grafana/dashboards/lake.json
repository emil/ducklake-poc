            "uid": "ducklake-catalog"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT id, experiment, shot, stage, data_version, status, attempts, left(last_error, 160) AS last_error, created_at FROM ingest_queue WHERE status = 'failed' OR attempts > 1 ORDER BY id DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
