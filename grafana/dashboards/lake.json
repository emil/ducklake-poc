    {
      "id": 22,
      "type": "stat",
      "title": "Oldest pending",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ducklake-catalog"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
