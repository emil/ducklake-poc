    {
      "id": 24,
      "type": "timeseries",
      "title": "Queue throughput (per 5 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ducklake-catalog"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ducklake-catalog"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, sum(enqueued) AS enqueued, sum(completed) AS completed FROM (SELECT $__timeGroup(created_at, '5m') AS time, count(*) AS enqueued, 0 AS completed FROM ingest_queue WHERE $__timeFilter(created_at) GROUP BY 1 UNION ALL SELECT $__timeGroup(processed_at, '5m') AS time, 0, count(*) FROM ingest_queue WHERE status = 'completed' AND $__timeFilter(processed_at) GROUP BY 1) t GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Versions enqueued and completed in the time range. The queue keeps no depth history, so this shows throughput."
    },
    {
      "id": 25,
      "type": "table",
      "title": "Failed and retried versions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
