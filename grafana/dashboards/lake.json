          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT experiment, shot, count(DISTINCT stage) AS stages, count(DISTINCT data_version) AS versions, sum(row_group_rows) AS rows FROM wave_manifest GROUP BY experiment, shot ORDER BY experiment, shot DESC LIMIT 50"
